# Copia este archivo a .env.prod y rellena los valores (README, sección "Instalar").
# .env.prod NUNCA se sube a Git.

# Dominio del cliente: Caddy saca el certificado HTTPS solo (debe apuntar al servidor).
# Para probar en tu PC sin HTTPS: SITE_ADDRESS=:80 y HTTP_PORT=8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Base de datos. Genera cada clave con:  openssl rand -hex 16
DB_USER=menu_user
DB_PASSWORD=
DB_NAME=menu_db
APP_DB_USER=menu_app
APP_DB_PASSWORD=

# Firma de las sesiones. Genera con:  openssl rand -hex 32
JWT_SECRET=
